{
  "name": "any-hunter",
  "version": "1.1.2",
  "description": "Zero-dependency AST & Semantic Type-Health Auditor for TypeScript",
  "type": "module",
  "bin": {
    "any-hunter": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "audit": "node dist/index.js ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "typescript",
    "type-health",
    "type-safety",
    "ast",
    "linter",
    "static-analysis",
    "sarif",
    "code-quality",
    "zero-dependencies",
    "github-actions"
  ],
  "author": {
    "name": "Jacob Palomo",
    "email": "jacob.palomo248@gmail.com",
    "url": "https://github.com/JacobPalomo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobPalomo/any-hunter.git"
  },
  "bugs": {
    "url": "https://github.com/JacobPalomo/any-hunter/issues"
  },
  "homepage": "https://github.com/JacobPalomo/any-hunter#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
